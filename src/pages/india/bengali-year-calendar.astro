<script>
  // The grids are build-time static; only "today" needs the visitor's clock.
  function highlightToday() {
    const now = new Date();
    const iso = now.getFullYear() + '-' +
      String(now.getMonth() + 1).padStart(2, '0') + '-' +
      String(now.getDate()).padStart(2, '0');

    const cell = document.querySelector('[data-date="' + iso + '"]');
    if (!cell) return; // today falls outside the Bengali year this build rendered

    cell.classList.remove('bg-gray-50', 'bg-saffron-50', 'border-gray-100');
    cell.classList.add('bg-saffron-700', 'border-saffron-700', 'ring-2', 'ring-saffron-300');
    cell.querySelectorAll('span').forEach((s) => {
      s.classList.remove('text-gray-900', 'text-gray-500', 'text-saffron-800');
      s.classList.add('text-white');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', highlightToday);
  } else {
    highlightToday();
  }
</script>
