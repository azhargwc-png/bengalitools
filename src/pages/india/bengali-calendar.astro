---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import AdSlot from '../../components/AdSlot.astro';
import {
  BENGALI_MONTHS,
  BENGALI_MONTHS_EN,
  MONTH_PERIODS_BN,
  MONTH_PERIODS_EN,
  MONTH_LENGTHS,
  toBengaliDigits,
  formatBengaliDate,
} from '../../utils/bengaliCalendar.js';

// Build-time value so crawlers and no-JS visitors see a real date rather than a
// placeholder. The inline script below re-computes it on load, so what the
// visitor actually sees is always today — this is only the pre-render seed.
const seed = formatBengaliDate(new Date());

// Derived from MONTH_LENGTHS so the prose can't contradict the table.
const longMonths = MONTH_LENGTHS.filter((d) => d === 31).length;
const shortMonths = MONTH_LENGTHS.length - longMonths;

const monthListBn = BENGALI_MONTHS.join(', ');
const monthListEn = BENGALI_MONTHS_EN.join(', ');

// One FAQ source feeding both the FAQPage schema and the rendered <details>.
const faqs = [
  {
    q: { bn: 'আজকের বাংলা তারিখ কত?', en: "What is today's Bengali date?" },
    a: {
      bn: `আজকের বাংলা তারিখ এই পাতার উপরে স্বয়ংক্রিয়ভাবে দেখানো হয় — বাংলা দিন, মাস ও বঙ্গাব্দসহ। পাতাটি খুললেই আপনার ডিভাইসের তারিখ অনুযায়ী আজকের বাংলা তারিখ দেখতে পাবেন, কিছু নির্বাচন করার দরকার নেই।`,
      en: `Today's Bengali date is shown automatically at the top of this page, with the Bengali day, month and year. It is computed from your device's date as soon as the page opens — nothing to select.`,
    },
  },
  {
    q: { bn: 'পহেলা বৈশাখ কবে?', en: 'When is Pohela Boishakh?' },
    a: {
      bn: 'পহেলা বৈশাখ সাধারণত ১৪ এপ্রিল বা ১৫ এপ্রিল হয়। ভারতে সাধারণত ১৫ এপ্রিল এবং বাংলাদেশে ১৪ এপ্রিল পালিত হয়।',
      en: 'Pohela Boishakh usually falls on April 14 or 15. In India it is generally celebrated on April 15, in Bangladesh on April 14.',
    },
  },
  {
    q: { bn: 'বাংলা সন কত?', en: 'What is the current Bengali year?' },
    a: {
      bn: 'বাংলা সন বের করতে ইংরেজি বছর থেকে ৫৯৩ বিয়োগ করুন (পহেলা বৈশাখ পেরিয়ে গেলে)। বৈশাখ (এপ্রিল) থেকে নতুন বাংলা বছর শুরু হয়, তাই এক ইংরেজি বছরে দুটি বাংলা সন পড়ে।',
      en: 'Subtract 593 from the English year once Pohela Boishakh has passed. The Bengali year begins in Boishakh (April), so a single English year spans two Bengali years.',
    },
  },
  {
    q: { bn: 'বাংলা বছরে কত দিন?', en: 'How many days are in a Bengali year?' },
    a: {
      bn: `বাংলা বছরে ৩৬৫ দিন (অধিবর্ষে ৩৬৬ দিন)। প্রথম ${toBengaliDigits(longMonths)} মাসে ৩১ দিন এবং পরের ${toBengaliDigits(shortMonths)} মাসে ৩০ দিন। অধিবর্ষে ফাল্গুন মাস ৩১ দিনের হয়।`,
      en: `A Bengali year has 365 days (366 in a leap year). The first ${longMonths} months have 31 days and the remaining ${shortMonths} have 30. In a leap year Falgun has 31 days.`,
    },
  },
  {
    q: { bn: 'বাংলাদেশে বাংলা ক্যালেন্ডার কি ভারতের মতো?', en: 'Is the Bengali calendar in Bangladesh the same as India?' },
    a: {
      bn: 'প্রায় একই, তবে সামান্য পার্থক্য আছে। এই পাতায় পশ্চিমবঙ্গের প্রচলিত হিসাব ব্যবহার করা হয়েছে, যেখানে পহেলা বৈশাখ ১৫ এপ্রিল। বাংলাদেশে বাংলা একাডেমি সংস্করণ অনুসরণ করা হয় যেখানে নববর্ষ ১৪ এপ্রিল, ফলে তারিখ এক দিন আলাদা হতে পারে।',
      en: 'Almost the same, with minor differences. This page uses the traditional West Bengal reckoning, where Pohela Boishakh is April 15. Bangladesh follows the Bangla Academy version where New Year falls on April 14, so dates can differ by a day.',
    },
  },
  {
    q: { bn: 'বাংলা মাসের নাম কীভাবে মনে রাখব?', en: 'How to remember Bengali month names?' },
    a: {
      bn: `ছড়া: ${BENGALI_MONTHS.slice(0, 6).join(' ')}, ${BENGALI_MONTHS.slice(6).join(' ')}।`,
      en: `Mnemonic: ${BENGALI_MONTHS_EN.slice(0, 6).join(' ')}, ${BENGALI_MONTHS_EN.slice(6).join(' ')}.`,
    },
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "আজকের বাংলা তারিখ — Bengali Calendar Today",
      "url": "https://www.bengalitools.com/india/bengali-calendar/",
      "description": `আজকের বাংলা তারিখ, বাংলা মাস ও বঙ্গাব্দ স্বয়ংক্রিয়ভাবে দেখুন। যেকোনো ইংরেজি তারিখও বাংলা তারিখে রূপান্তর করুন। বাংলা মাস: ${monthListBn}।`,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web Browser",
      "inLanguage": "bn",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q.bn,
        "acceptedAnswer": { "@type": "Answer", "text": f.a.bn }
      }))
    }
  ]
};
---

<ToolLayout
  title="Bengali Calendar Today — আজকের বাংলা তারিখ | BanglaTools"
  description="See today's Bengali date, month and year instantly. আজকের বাংলা তারিখ, বাংলা মাস ও বঙ্গাব্দ। Bengali Calendar Today — plus convert any English date to the Bengali calendar."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)}></script>

  <h1 class="text-3xl font-bold text-gray-900 mb-2">
    <span data-bn="আজকের বাংলা তারিখ" data-en="Today's Bengali Date">আজকের বাংলা তারিখ</span>
  </h1>
  <p class="text-gray-600 mb-6 text-lg">
    <span data-bn="আজকের বাংলা দিন, মাস ও বঙ্গাব্দ — সঙ্গে যেকোনো ইংরেজি তারিখের রূপান্তর" data-en="Today's Bengali day, month and year — plus conversion for any English date">আজকের বাংলা দিন, মাস ও বঙ্গাব্দ — সঙ্গে যেকোনো ইংরেজি তারিখের রূপান্তর</span>
  </p>

  <AdSlot slot="above-tool" />

  <!-- PRIMARY: today's Bengali date, computed on load -->
  <section class="mb-8">
    <div class="bg-saffron-50 rounded-2xl p-6 md:p-8 border-2 border-saffron-200 text-center">
      <p class="text-sm font-semibold text-saffron-700 uppercase tracking-wide mb-2">
        <span data-bn="আজকের বাংলা তারিখ" data-en="Today's Bengali Date">আজকের বাংলা তারিখ</span>
      </p>
      <p id="today-bn-date" class="text-4xl md:text-5xl font-bold text-saffron-800 leading-tight">{seed.full}</p>
      <p id="today-bn-month" class="text-lg text-saffron-700 mt-2">{seed.monthBn} ({seed.monthEn})</p>
      <p id="today-bn-day" class="text-base text-saffron-700">{seed.dayNameBn}</p>

      <div class="grid grid-cols-2 gap-3 mt-6">
        <div class="bg-white rounded-xl p-4 border border-gray-200">
          <p class="text-sm text-gray-500 mb-1" data-bn="বাংলা মাস" data-en="Bengali Month">বাংলা মাস</p>
          <p id="today-month-only" class="text-xl font-bold text-gray-900">{seed.monthBn}</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-gray-200">
          <p class="text-sm text-gray-500 mb-1" data-bn="বাংলা বছর" data-en="Bengali Year">বাংলা বছর</p>
          <p id="today-year-only" class="text-xl font-bold text-gray-900">{toBengaliDigits(seed.year)} বঙ্গাব্দ</p>
        </div>
      </div>

      <div class="bg-white rounded-xl p-4 border border-gray-200 mt-3">
        <p class="text-sm text-gray-500 mb-1" data-bn="আজকের ইংরেজি তারিখ" data-en="Today's English Date">আজকের ইংরেজি তারিখ</p>
        <p id="today-en-date" class="text-lg font-medium text-gray-700">{seed.gregorianEn}</p>
      </div>
    </div>
  </section>

  <!-- SECONDARY: convert some other date -->
  <section class="mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">
      <span data-bn="অন্য কোনো তারিখ রূপান্তর করুন" data-en="Convert a Different Date">অন্য কোনো তারিখ রূপান্তর করুন</span>
    </h2>
    <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1" for="date-input">
            <span data-bn="ইংরেজি তারিখ নির্বাচন করুন" data-en="Select English Date">ইংরেজি তারিখ নির্বাচন করুন</span>
          </label>
          <input
            type="date"
            id="date-input"
            class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl text-lg focus:border-saffron-500 focus:outline-none min-h-[44px]"
          />
        </div>

        <button
          id="btn-today"
          type="button"
          class="px-4 py-2 bg-saffron-700 hover:bg-saffron-800 text-white rounded-lg text-sm font-medium transition-colors"
        >
          <span data-bn="আজকের তারিখ বসান" data-en="Use Today's Date">আজকের তারিখ বসান</span>
        </button>
      </div>

      <!-- Result -->
      <div id="calendar-result" class="mt-6 hidden space-y-3">
        <div class="bg-white rounded-xl p-5 border border-saffron-200 text-center">
          <p class="text-sm text-saffron-700 mb-1" data-bn="বাংলা তারিখ" data-en="Bengali Date">বাংলা তারিখ</p>
          <p id="bn-date" class="text-3xl font-bold text-saffron-800"></p>
          <p id="bn-month-name" class="text-lg text-saffron-700 mt-1"></p>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white rounded-xl p-4 border border-gray-200 text-center">
            <p class="text-sm text-gray-500 mb-1" data-bn="বাংলা মাস" data-en="Bengali Month">বাংলা মাস</p>
            <p id="bn-month" class="text-xl font-bold text-gray-900"></p>
          </div>
          <div class="bg-white rounded-xl p-4 border border-gray-200 text-center">
            <p class="text-sm text-gray-500 mb-1" data-bn="বাংলা বছর" data-en="Bengali Year">বাংলা বছর</p>
            <p id="bn-year" class="text-xl font-bold text-gray-900"></p>
          </div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-gray-200 text-center">
          <p class="text-sm text-gray-500 mb-1" data-bn="ইংরেজি তারিখ" data-en="English Date">ইংরেজি তারিখ</p>
          <p id="en-date-display" class="text-lg font-medium text-gray-700"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bengali months table -->
  <section class="mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4"><span data-bn="বাংলা মাসের নাম" data-en="Bengali Month Names">বাংলা মাসের নাম</span></h2>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-saffron-700 text-white">
            <th class="p-3 text-left rounded-tl-lg"><span data-bn="বাংলা মাস" data-en="Bengali Month">বাংলা মাস</span></th>
            <th class="p-3 text-left"><span data-bn="ইংরেজি উচ্চারণ" data-en="English Pronunciation">ইংরেজি উচ্চারণ</span></th>
            <th class="p-3 text-left rounded-tr-lg"><span data-bn="আনুমানিক সময়" data-en="Approx. Period">আনুমানিক সময়</span></th>
          </tr>
        </thead>
        <tbody>
          {BENGALI_MONTHS.map((monthBn, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="p-3 font-bold text-saffron-700">{monthBn}</td>
              <td class="p-3 text-gray-700">{BENGALI_MONTHS_EN[i]}</td>
              <td class="p-3 text-gray-600 text-xs">{MONTH_PERIODS_BN[i]} / {MONTH_PERIODS_EN[i]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- How to use -->
  <section class="mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4"><span data-bn="কীভাবে ব্যবহার করবেন" data-en="How to Use">কীভাবে ব্যবহার করবেন</span></h2>
    <ol class="space-y-3 text-gray-700">
      <li class="flex gap-3"><span class="font-bold text-saffron-700 min-w-[24px]">১.</span><span data-bn="পাতাটি খুললেই উপরে আজকের বাংলা তারিখ দেখতে পাবেন" data-en="Open the page — today's Bengali date appears at the top">পাতাটি খুললেই উপরে আজকের বাংলা তারিখ দেখতে পাবেন</span></li>
      <li class="flex gap-3"><span class="font-bold text-saffron-700 min-w-[24px]">২.</span><span data-bn="অন্য তারিখ জানতে নিচের বক্সে ইংরেজি তারিখ নির্বাচন করুন" data-en="To check another date, pick an English date in the box below">অন্য তারিখ জানতে নিচের বক্সে ইংরেজি তারিখ নির্বাচন করুন</span></li>
      <li class="flex gap-3"><span class="font-bold text-saffron-700 min-w-[24px]">৩.</span><span data-bn="বাংলা তারিখ, মাস ও বছর সঙ্গে সঙ্গে দেখুন" data-en="See the Bengali date, month and year instantly">বাংলা তারিখ, মাস ও বছর সঙ্গে সঙ্গে দেখুন</span></li>
    </ol>
  </section>

  <!-- Description -->
  <section class="mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4"><span data-bn="এই টুলটি কী করে" data-en="What This Tool Does">এই টুলটি কী করে</span></h2>
    <div class="text-gray-700 leading-relaxed">
      <p>
        বাংলা ক্যালেন্ডার (বঙ্গাব্দ) ইংরেজি ক্যালেন্ডার থেকে আলাদা। বাংলা বছরের শুরু হয় পহেলা বৈশাখে, যা সাধারণত ১৪ বা ১৫ এপ্রিল হয়। বাংলা বছর ইংরেজি বছরের চেয়ে ৫৯৩ বছর পিছিয়ে আছে। এই পাতায় আজকের বাংলা তারিখ স্বয়ংক্রিয়ভাবে দেখানো হয় — বাংলা দিন, মাস ও বঙ্গাব্দসহ। পহেলা বৈশাখ উদযাপন, বাংলা নববর্ষ, পূজার তারিখ ইত্যাদি জানতে এই টুলটি ব্যবহার করুন। বাংলা মাসগুলো হলো: {monthListBn}।
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4"><span data-bn="সাধারণ প্রশ্নোত্তর" data-en="Frequently Asked Questions">সাধারণ প্রশ্নোত্তর</span></h2>
    <div class="space-y-4">
      {faqs.map((f) => (
        <details class="bg-gray-50 rounded-xl p-4 border border-gray-200">
          <summary class="font-semibold text-gray-900 cursor-pointer"><span data-bn={f.q.bn} data-en={f.q.en}>{f.q.bn}</span></summary>
          <p class="mt-3 text-gray-700"><span data-bn={f.a.bn} data-en={f.a.en}>{f.a.bn}</span></p>
        </details>
      ))}
    </div>
  </section>

  <AdSlot slot="below-faq" />

  <RelatedTools tools={[
    { url: "/health/age-calculator", nameBn: "বয়স ক্যালকুলেটর", nameEn: "Age Calculator", descBn: "সঠিক বয়স বের করুন", descEn: "Calculate exact age", icon: "🎂" },
    { url: "/calculators/date-difference", nameBn: "দুই তারিখের ব্যবধান", nameEn: "Date Difference", descBn: "দুই তারিখের মধ্যে দিন", descEn: "Days between dates", icon: "📅" },
    { url: "/india/number-to-bengali", nameBn: "সংখ্যা বাংলায়", nameEn: "Number to Bengali", descBn: "সংখ্যা বাংলা শব্দে", descEn: "Number to Bengali words", icon: "🔢" }
  ]} />
</ToolLayout>

<script>
  import { toBengaliDigits, formatBengaliDate } from '../../utils/bengaliCalendar.js';

  function setText(id: string, value: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  // Overwrite the build-time seed with the visitor's actual today.
  function renderToday() {
    const t = formatBengaliDate(new Date());
    setText('today-bn-date', t.full);
    setText('today-bn-month', t.monthBn + ' (' + t.monthEn + ')');
    setText('today-bn-day', t.dayNameBn);
    setText('today-month-only', t.monthBn);
    setText('today-year-only', toBengaliDigits(t.year) + ' বঙ্গাব্দ');
    setText('today-en-date', t.gregorianEn);
  }

  function convertDate() {
    const input = document.getElementById('date-input') as HTMLInputElement | null;
    const box = document.getElementById('calendar-result');
    if (!input || !box) return;

    if (!input.value) { box.classList.add('hidden'); return; }

    const [year, month, day] = input.value.split('-').map(Number);
    if (!year || !month || !day) { box.classList.add('hidden'); return; }

    const r = formatBengaliDate(new Date(year, month - 1, day));

    setText('bn-date', r.full);
    setText('bn-month-name', r.monthBn + ' (' + r.monthEn + ')');
    setText('bn-month', r.monthBn);
    setText('bn-year', toBengaliDigits(r.year) + ' বঙ্গাব্দ');
    setText('en-date-display', r.gregorianEn + ' (' + r.dayNameBn + ')');

    box.classList.remove('hidden');
  }

  function fillToday() {
    const input = document.getElementById('date-input') as HTMLInputElement | null;
    if (!input) return;
    const now = new Date();
    input.value = now.getFullYear() + '-' +
      String(now.getMonth() + 1).padStart(2, '0') + '-' +
      String(now.getDate()).padStart(2, '0');
    convertDate();
  }

  function init() {
    renderToday();
    document.getElementById('date-input')?.addEventListener('change', convertDate);
    document.getElementById('btn-today')?.addEventListener('click', fillToday);
    fillToday();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
